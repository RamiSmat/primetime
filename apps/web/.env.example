# Names only — never real values. See CLAUDE.md / AGENTS.md: this backend must
# never receive, store, or log provider (Codex/Claude/etc.) authentication
# material. None of the variables below are provider credentials; they
# configure the GitHub App and database this backend uses to mint short-lived,
# repository-scoped GitHub tokens on behalf of a user's own Actions runs.

# The GitHub App's numeric ID (from the App's settings page).
GITHUB_APP_ID=

# The GitHub App's private key (PKCS#8 PEM), base64-encoded so it survives
# being stored as a single-line platform environment variable.
GITHUB_APP_PRIVATE_KEY_BASE64=

# The secret configured on the GitHub App's webhook settings page, used to
# verify that webhook deliveries actually came from GitHub.
GITHUB_APP_WEBHOOK_SECRET=

# Neon Postgres connection string used to track installations/repositories.
DATABASE_URL=

# The `aud` claim GitHub Actions workflows must request their OIDC token
# with (via `audience=` on $ACTIONS_ID_TOKEN_REQUEST_URL) for this backend to
# accept it — typically this deployment's own URL.
OIDC_AUDIENCE=
